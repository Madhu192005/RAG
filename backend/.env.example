# ==============================================================================
# WasteWise AI – Backend Environment Variables (.env.example)
# Copy this file to .env and replace placeholders. Never commit real credentials.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="WasteWise AI"
VERSION="0.4.0"
ENVIRONMENT="development"
DEBUG=True

# Choose one database configuration. DATABASE_URL takes precedence when set.
# Existing MySQL (PyMySQL) configuration; retained during the transition.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wastewise_db
DB_USER=root
DB_PASSWORD=your_password

# Neon PostgreSQL (psycopg 3). Copy the pooled URL from Neon and keep SSL enabled.
# Use the hostname containing "-pooler" when connecting through Neon pooling.
# Percent-encode special characters in credentials if constructing the URL manually.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech:5432/wastewise_db?sslmode=require
# DATABASE_URL takes precedence over the DB_* MySQL settings above.

# Optional full URL override; SQLite tests set this in tests/conftest.py.
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/wastewise_db

# JWT
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq (select a currently supported model in your Groq account)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=your_supported_groq_model

# RAG model/runtime configuration
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_SEMANTIC_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_HYBRID_TOP_K=12
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
RAG_CONTEXT_MAX_CHARS=12000
RAG_HISTORY_LIMIT=6
RAG_GROQ_TIMEOUT_SECONDS=30

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000
